# Fire & Space Environment Configuration

PORT=3000
NODE_ENV=development

# NASA FIRMS API Key (Get free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# If empty, the system automatically uses real NASA satellite observation benchmark data
FIRMS_API_KEY=

# MongoDB URI (MongoDB operational database)
# If empty or unreachable, in-memory MongoDB operational store with 2dsphere indexing is used
MONGODB_URI=mongodb+srv://amanc8399_db_user:uJ2qMP48cc1QsUR@cluster0.nqut7o4.mongodb.net/

# OpenWeather API Key (optional - Open-Meteo fallback is built-in with zero key requirement)
OPENWEATHER_API_KEY=

# Python Geo-Engine Service URL
GEO_ENGINE_URL=http://localhost:8000

# Snowflake Data Warehouse (Historical analytical storage)
# If credentials are not provided, built-in simulated Snowflake SQL analytics engine responds to analytics queries
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=alialiahm@student.iul.ac.in
SNOWFLAKE_PASSWORD=Ali_9354241551
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FIRE_SPACE
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=ACCOUNTADMIN

# DBSCAN Spatial Clustering Parameters
# Distance threshold in kilometers (haversine metric)
DBSCAN_EPS_KM=2.5
# Minimum number of radiometric hotspots to form an individual fire cluster
DBSCAN_MIN_SAMPLES=3

# Background Satellite Ingestion Schedule
# Refresh interval in minutes (10 - 60)
FIRE_REFRESH_MINUTES=15

# Mapbox Token (Optional: Leaflet uses CartoDB Dark Matter / Esri Satellite by default)
MAPBOX_TOKEN=
